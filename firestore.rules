rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Auth tokens do not contain custom claims in this env. We lookup the user document.
    function getUserData() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; 
    }
    
    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().get('role', 'student') == role;
    }
    
    function isAdmin() { 
      return (isSignedIn() && request.auth.token.email == 'castanar656@gmail.com') || hasRole('admin');
    }
    
    function isInstructor() { 
       return hasRole('instructor') || isAdmin(); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) && 
             data.email is string && data.email.size() <= 200 &&
             data.role in ['student', 'instructor', 'admin'];
    }

    // --- RULES ---

    match /users/{userId} {
      // Allow user to read their own profile, or admins/instructors to read.
      // Also allow reading by email if it matches the auth token (for profile claiming).
      allow read: if isOwner(userId) || isAdmin() || isInstructor() || (isSignedIn() && resource.data.email == request.auth.token.email);
      
      // Only the user or admin can create the user doc on signup.
      allow create: if isOwner(userId) && isValidUser(incoming()) || isAdmin();
      
      // Allow self-update for non-sensitive fields. Allow admin to update everything.
      allow update: if (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(["role", "email"])) || isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().email == request.auth.token.email);
    }
    
    match /learnerProfiles/{userId} {
      allow read: if isOwner(userId) || isInstructor();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
    
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /mockExamAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }

    match /textbooks/{textbookId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /questions/{questionId} {
      allow read: if isSignedIn() && (resource.data.get('approved', false) == true || isInstructor());
      allow write: if isInstructor();
    }

    match /skills/{skillId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isInstructor();
      allow update: if isInstructor() && (existing().instructorId == request.auth.uid || existing().instructorEmail == request.auth.token.email || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /classEnrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (incoming().studentId == request.auth.uid || isInstructor());
      allow update, delete: if isInstructor() || isOwner(existing().studentId);
    }
    
    match /diagnosticAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    match /moduleProgress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid || (resource != null && existing().userId == request.auth.uid));
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isInstructor();
    }

    match /assignmentSubmissions/{submissionId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow update: if isInstructor() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /learningNotes/{noteId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
    }
    
    match /aiDrafts/{draftId} {
      allow read, write: if isInstructor();
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /system/{docId} {
      allow read, write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if isInstructor() || isAdmin() || (
        isSignedIn() &&
        incoming().createdBy == request.auth.uid &&
        incoming().get('type', '') == 'grade_appeal'
      );
      allow read: if isSignedIn() && (
        resource.data.get('recipientIds', []).hasAny([request.auth.uid]) ||
        resource.data.get('roleRecipients', []).hasAny([getUserData().get('role', 'student')]) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.get('recipientIds', []).hasAny([request.auth.uid]) ||
        resource.data.get('roleRecipients', []).hasAny([getUserData().get('role', 'student')]) ||
        isAdmin()
      ) && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'status']);
      allow delete: if isAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /activityLogs/{logId} {
      allow list, read: if isAdmin();
      allow create: if isSignedIn();
    }
    
    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow update: if isInstructor();
    }
  }
}
