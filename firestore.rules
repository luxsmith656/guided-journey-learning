rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Auth tokens do not contain custom claims in this env. We lookup the user document.
    function getUserData() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; 
    }
    
    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().get('role', 'student') == role;
    }
    
    function isAdmin() { 
      return (isSignedIn() && request.auth.token.email == 'castanar656@gmail.com') || hasRole('admin');
    }
    
    function isInstructor() { 
       return hasRole('instructor') || isAdmin(); 
    }
    function isDemoAccount() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          getUserData().get('isDemo', false) == true ||
          getUserData().get('email', '') in ['student@letmastery.com', 'instructor@letmastery.com', 'admin@letmastery.com']
        );
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOpenAttemptStatus(status) {
      return status in ['instructions', 'in_progress', 'warning_blocked', 'offline_buffering', 'auto_submitting'];
    }
    function isAllowedStudentAttemptStatus(status) {
      return status in [
        'instructions',
        'in_progress',
        'warning_blocked',
        'offline_buffering',
        'auto_submitting',
        'submitted',
        'auto_submitted_time_expired',
        'auto_submitted_warnings',
        'auto_submitted_idle',
        'auto_submitted_offline',
        'flagged_for_review'
      ];
    }
    function isOwnedOpenAttemptUpdate() {
      return isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        isOpenAttemptStatus(existing().get('status', 'in_progress')) &&
        isAllowedStudentAttemptStatus(incoming().get('status', 'in_progress'));
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) && 
             data.email is string && data.email.size() <= 200 &&
             data.role in ['student', 'instructor', 'admin'];
    }

    // --- RULES ---

    match /users/{userId} {
      // Allow user to read their own profile, or admins/instructors to read.
      // Also allow reading by email if it matches the auth token (for profile claiming).
      allow read: if isOwner(userId) || isAdmin() || isInstructor() || (isSignedIn() && resource.data.email == request.auth.token.email);
      
      // Only the user or admin can create the user doc on signup.
      allow create: if isOwner(userId) && isValidUser(incoming()) || isAdmin();
      
      // Allow self-update for non-sensitive fields. Allow admin to update everything.
      allow update: if (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(["role", "email"])) || isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().email == request.auth.token.email);
    }
    
    match /learnerProfiles/{userId} {
      allow read: if isOwner(userId) || isInstructor();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin() || (isDemoAccount() && isOwner(userId));
    }
    
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || isOwnedOpenAttemptUpdate();
      allow delete: if isAdmin() || (isDemoAccount() && existing().userId == request.auth.uid);
    }
    
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }

    match /reviewTracks/{trackId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /studentReviewSettings/{userId} {
      allow read: if isOwner(userId) || isInstructor();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /examBlueprints/{blueprintId} {
      allow read: if isSignedIn();
      allow create, update: if isInstructor();
      allow delete: if isAdmin();
    }

    match /questionBanks/{bankId} {
      allow read, create, update: if isInstructor();
      allow delete: if isAdmin();
    }
    
    match /mockExamAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || isOwnedOpenAttemptUpdate();
      allow delete: if isAdmin() || (isDemoAccount() && existing().userId == request.auth.uid);
    }

    match /mistakeBank/{mistakeId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
    
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }

    match /textbooks/{textbookId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /questions/{questionId} {
      allow read: if isSignedIn() && (resource.data.get('approved', false) == true || isInstructor());
      allow write: if isInstructor();
    }

    match /skills/{skillId} {
      allow read: if isSignedIn();
      allow write: if isInstructor();
    }
    
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isInstructor();
      allow update: if isInstructor() && (existing().instructorId == request.auth.uid || existing().instructorEmail == request.auth.token.email || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /classEnrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (incoming().studentId == request.auth.uid || isInstructor());
      allow update, delete: if isInstructor() || isOwner(existing().studentId);
    }
    
    match /diagnosticAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isDemoAccount() && existing().userId == request.auth.uid);
    }

    match /moduleProgress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid || (resource != null && existing().userId == request.auth.uid));
      allow delete: if isAdmin() || (isDemoAccount() && existing().userId == request.auth.uid);
    }

    match /examAttemptLogs/{attemptId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isDemoAccount() && existing().userId == request.auth.uid);
    }

    match /studyReminders/{reminderId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /learningNotes/{noteId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
    }

    match /learningAnnotations/{annotationId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow update: if isSignedIn() && (
        isInstructor() ||
        (resource.data.userId == request.auth.uid && incoming().userId == resource.data.userId)
      );
    }

    match /highlights/{highlightId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /hiddenBlocks/{blockId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /bookmarks/{bookmarkId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /contentVersions/{versionId} {
      allow read: if isInstructor();
      allow create: if isInstructor();
      allow update, delete: if isAdmin();
    }

    match /moduleComments/{commentId} {
      allow read, create: if isInstructor();
      allow update: if isInstructor() || isAdmin();
      allow delete: if isAdmin();
    }

    match /changeLogs/{logId} {
      allow read: if isInstructor();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    match /aiDrafts/{draftId} {
      allow read, write: if isInstructor();
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /system/{docId} {
      allow read, write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if isInstructor() || isAdmin() || (
        isSignedIn() &&
        incoming().createdBy == request.auth.uid &&
        incoming().get('type', '') == 'grade_appeal'
      );
      allow read: if isSignedIn() && (
        resource.data.get('recipientIds', []).hasAny([request.auth.uid]) ||
        resource.data.get('roleRecipients', []).hasAny([getUserData().get('role', 'student')]) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.get('recipientIds', []).hasAny([request.auth.uid]) ||
        resource.data.get('roleRecipients', []).hasAny([getUserData().get('role', 'student')]) ||
        isAdmin()
      ) && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'status']);
      allow delete: if isAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create, update: if isInstructor();
      allow delete: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update: if isInstructor();
      allow delete: if isAdmin();
    }
    
    match /activityLogs/{logId} {
      allow list, read: if isAdmin();
      allow create: if isSignedIn();
    }
    
    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isInstructor());
      allow update: if isInstructor();
    }
  }
}
